{
  "name": "cdms-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Clinical Department Management System (CDMS) - Hebron University, Faculty of Medicine. Frontend SPA.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:legacy-root": "npm run build && node -e \"const fs=require('fs'); for (const p of ['../assets','../index.html','../favicon.svg','../templates']) fs.rmSync(p,{recursive:true,force:true}); fs.cpSync('dist','..',{recursive:true});\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:i18n": "node scripts/audit-i18n.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.62.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.33.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-router-dom": "^7.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "pdf-parse": "^2.4.5",
    "pdf2json": "^4.0.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "xlsx": "^0.18.5"
  }
}
