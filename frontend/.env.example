# CDMS Frontend — environment configuration template.
# Copy to .env.local for local development. Never commit real .env* files
# beyond this template (see .gitignore).

# Base URL of the backend API, including the version prefix. Never hardcode
# http://localhost/... inside component/business code — always read it from
# here (see src/api/client.ts).
VITE_API_BASE_URL=http://localhost:8000/api/v1
