# Copy to .env.docker and replace every CHANGE_ME value before deployment.
# The real file is ignored by Git. Keep it readable only by server operators.

COMPOSE_PROJECT_NAME=cdms
HTTP_PORT=80

APP_NAME=CDMS
APP_ENV=production
APP_KEY=CHANGE_ME_GENERATE_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://cdms.hebron.edu
APP_TIMEZONE=Asia/Hebron
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cdms
DB_USERNAME=cdms_user
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD

FRONTEND_URLS=https://cdms.hebron.edu
SANCTUM_STATEFUL_DOMAINS=cdms.hebron.edu
SESSION_DOMAIN=cdms.hebron.edu
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=cdms_session

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
HEALTH_MIN_FREE_STORAGE_MB=100
HEALTH_STALLED_JOB_MINUTES=5

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME_SMTP_HOST
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=CHANGE_ME_SMTP_USERNAME
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_FROM_ADDRESS=CHANGE_ME_MAIL_FROM_ADDRESS
MAIL_FROM_NAME="CDMS - Clinical Department"
STUDENT_EMAIL_DOMAIN=students.hebron.edu
GROUP_REGISTRATION_OTP_TTL_MINUTES=10
GROUP_REGISTRATION_SESSION_TTL_MINUTES=20

# Leave disabled until the documented backup packages and S3 destination exist.
BACKUP_ENABLED=false
BACKUP_ALERT_EMAIL=CHANGE_ME_OPERATIONS_EMAIL
BACKUP_ARCHIVE_PASSWORD=CHANGE_ME_BACKUP_PASSWORD
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

SEED_DEV_ADMIN=false

