DirectoryIndex index.php index.html
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Route /sanctum requests to backend/public/index.php
    RewriteCond %{REQUEST_URI} ^/sanctum [NC]
    RewriteRule ^sanctum(.*)$ backend/public/index.php [L,QSA]

    # Route /api requests to backend/public/index.php
    RewriteCond %{REQUEST_URI} ^/api [NC]
    RewriteRule ^api(.*)$ backend/public/index.php [L,QSA]

    # Route /storage requests to backend/public/storage
    RewriteCond %{REQUEST_URI} ^/storage [NC]
    RewriteRule ^storage(.*)$ backend/public/storage$1 [L,QSA]

    # Allow direct access to existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # SPA rewrite to index.html for all frontend routes
    RewriteRule ^ index.html [L]
</IfModule>
