/vendor
/node_modules
/.phpunit.cache
# PHPUnit writes this per-run result cache as a FILE, which the stock
# Laravel rule above (a directory) does not match — so it would otherwise be
# committed, and then churn on every test run.
/.phpunit.result.cache
/public/hot
/public/storage
/storage/*.key
/storage/pail
/storage/app/private/*
!/storage/app/private/.gitkeep
/storage/app/public/*
!/storage/app/public/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
.env
.env.backup
.env.production
.phpactor.json
Homestead.json
Homestead.yaml
auth.json
.fleet
.idea
.nova
.vscode
.zed
database/database.sqlite
