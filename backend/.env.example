# CDMS Backend — environment configuration template.
# Copy this file to .env and fill in real values. Never commit the real .env
# (see .gitignore) — no credential in this file is real.

APP_NAME=CDMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Hebron
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ---------------------------------------------------------------------------
# Database (MySQL 8.x — ARCHITECTURE.md). Never hardcode these in code.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cdms
DB_USERNAME=cdms_user
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Frontend origin(s) allowed to call this API (config/cors.php). Comma-
# separate multiple origins. Never use "*" here.
# ---------------------------------------------------------------------------
FRONTEND_URLS=http://localhost:5173

# ---------------------------------------------------------------------------
# Logging (config/logging.php)
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# ---------------------------------------------------------------------------
# Cache / Session / Queue — safe zero-infrastructure defaults.
# Switch to redis/database-backed drivers only when a later phase needs them
# (ARCHITECTURE.md: Redis/Queue are optional infrastructure).
# ---------------------------------------------------------------------------
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
HEALTH_MIN_FREE_STORAGE_MB=100
HEALTH_STALLED_JOB_MINUTES=5

# Production operations. Backups require spatie/laravel-backup and an S3
# filesystem adapter to be present in composer.lock before enabling.
BACKUP_ENABLED=false
BACKUP_ALERT_EMAIL=ops@example.invalid
BACKUP_ARCHIVE_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Authentication — Sanctum SPA cookie/session auth (Phase 2). The frontend
# origin(s) here must be host[:port] with NO scheme (unlike FRONTEND_URLS
# above, which does include the scheme) — e.g. "localhost:5173", not
# "http://localhost:5173". SESSION_DOMAIN should usually be left blank in
# local dev (blank = current host); set it explicitly in production if the
# frontend and backend share a parent domain (e.g. ".hebron.example").
# SESSION_SECURE_COOKIE must be false for local http:// development — the
# browser silently drops a Secure cookie sent over plain http, which looks
# like "login succeeds but every subsequent request is unauthenticated".
# Set it to true for any real (https://) deployment.
# ---------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:5173
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false

# ---------------------------------------------------------------------------
# LOCAL-DEVELOPMENT-ONLY admin bootstrap account (database/seeders/
# DevAdminUserSeeder.php). Ignored entirely unless APP_ENV=local. Leave
# SEED_DEV_ADMIN unset/false in any shared or production environment — this
# is not how real staff accounts are meant to be created (that's a future
# Users module). If DEV_ADMIN_PASSWORD is left blank, the seeder generates a
# random one and prints it once to the console; it is never written to a
# log file or committed anywhere.
# ---------------------------------------------------------------------------
SEED_DEV_ADMIN=false
DEV_ADMIN_EMAIL=admin@cdms.local
DEV_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Redis (optional — only needed if CACHE_STORE/QUEUE_CONNECTION/session use it)
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Student group-registration OTP mail (Gmail SMTP).
# Put the Gmail App Password in the real .env only. Never commit it.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=abdallhz@hebron.edu
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=abdallhz@hebron.edu
MAIL_FROM_NAME="CDMS - Clinical Department"
STUDENT_EMAIL_DOMAIN=students.hebron.edu
GROUP_REGISTRATION_OTP_TTL_MINUTES=10
GROUP_REGISTRATION_SESSION_TTL_MINUTES=20
